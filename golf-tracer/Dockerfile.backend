# Golf Tracer Backend
# CPU base — for GPU, use nvidia/cuda:12.1.0-runtime-ubuntu22.04 and
# change python base to python:3.12 (non-slim) with cuda libs.
FROM python:3.12-slim

WORKDIR /app

# System deps: FFmpeg for video processing, libGL for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download default YOLO weights (nano, CPU-friendly)
COPY backend/models/download_weights.py ./backend/models/download_weights.py
RUN python backend/models/download_weights.py --size n || true

# Copy application source
COPY backend/ ./backend/

# Create runtime dirs
RUN mkdir -p uploads exports

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
