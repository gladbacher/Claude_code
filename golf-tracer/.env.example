# Backend
DATABASE_URL=postgresql+asyncpg://golftracer:golftracer@localhost:5432/golftracer
STORAGE_BACKEND=local                # local | s3
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=500
USE_GPU=auto                         # auto | true | false
YOLO_MODEL_SIZE=n                    # n (nano) | m (medium) | l (large)
YOLO_CONFIDENCE_THRESHOLD=0.4
YOLO_IMPACT_CONFIDENCE=0.2

# S3 (only needed if STORAGE_BACKEND=s3)
S3_BUCKET=golf-tracer-videos
S3_ENDPOINT_URL=                     # leave blank for AWS, set for R2/MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# Redis (for future Celery queue; not required for asyncio MVP)
REDIS_URL=redis://localhost:6379/0
